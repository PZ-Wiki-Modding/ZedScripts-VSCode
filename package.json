{
  "name": "zedscripts",
  "displayName": "ZedScripts",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zedscripts.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:lsp && npm run package",
    "build:lsp": "make -C ZedScripts-LSP build",
    "compile": "tsc --noEmit -p ./ && node esbuild.js",
    "compile:extension": "tsc --noEmit -p ./ && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:tsc": "tsc --noEmit -w -p ./",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "tsc --noEmit -p ./ && node esbuild.js --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}
