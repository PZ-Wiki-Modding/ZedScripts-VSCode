{
  "name": "ZedScripts",
  "displayName": "ZedScripts",
  "description": "BETA - Implements the ZedScripts language server protocol inside Visual Studio Code",
  "publisher": "SimKDT",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pz-wiki-modding/ZedScripts-VSCode"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/pz-wiki-modding/ZedScripts-VSCode/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[plaintext]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[ZedScripts]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "ZedScripts",
        "aliases": [
          "zedscripts",
          "pz-scripts"
        ],
        "configuration": "./src/language/ZedScripts.configuration.json",
        "icon": {
          "dark": "icons/zedscripts_dark.svg",
          "light": "icons/zedscripts_light.svg"
        }
      },
      {
        "id": "ZedServer",
        "aliases": [
          "zedserver"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ZedScripts",
        "scopeName": "source.zedscripts",
        "path": "./src/language/ZedScripts.tmLanguage.json"
      },
      {
        "language": "ZedServer",
        "scopeName": "source.zedserver",
        "path": "./src/language/ZedServer.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "entity.name.recipe.pz": [
            "entity.name.recipe"
          ],
          "entity.name.item.pz": [
            "entity.name.item"
          ],
          "entity.name.recipe.name.pz": [
            "entity.name.recipe.name"
          ],
          "entity.name.item.name.pz": [
            "entity.name.item.name"
          ],
          "keyword.control.pz": [
            "keyword.control"
          ],
          "support.type.property-name.pz": [
            "support.type.property-name"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc --noEmit -p ./ && node esbuild.js",
    "compile:extension": "tsc --noEmit -p ./ && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:tsc": "tsc --noEmit -w -p ./",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "tsc --noEmit -p ./ && node esbuild.js --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}
